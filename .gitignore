data/
database/
logs/
frontend/
wrpl/replays/
wrpl/user_data/
images/logo/
images/maps/
images/vehicles/
core/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
wrpl_parser.py

# --- SÉCURITÉ ---
# Ne jamais envoyer le token ou les secrets
.env
*.sqlite
*.db

# --- DONNÉES LOCALES (Sera sur le laptop, pas sur GitHub) ---
# On ignore les bases de données et les fichiers de travail du bot

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
user_data/
datamine/
pip-log.txt
pip-delete-this-directory.txt

# --- Base de données et Données locales ---
# On ignore le contenu du dossier data, mais pas le dossier lui-même
vendor/*
!vendor/.gitkeep

data/*
!data/.gitkeep

replays/*
!replays/.gitkeep

user_data/*
!user_data/.gitkeep

*.log

logs/*
!logs/.gitkeep

frontend/*
!frontend/.gitkeep

database/*
!database/.gitkeep

images/*
!images/.gitkeep


# --- DOCKER & OS ---
.dockerignore
Dockerfile
docker-compose.yml
.DS_Store
Thumbs.db
/datamine/
